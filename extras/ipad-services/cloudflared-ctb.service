[Unit]
Description=Cloudflare Tunnel for Wrong Notebook (ctb.ghtxx.cn)
Wants=network-online.target wrong-notebook.service
After=network-online.target wrong-notebook.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cloudflared-ctb
Group=cloudflared-ctb
ExecStart=/opt/cloudflared/2026.10.7/cloudflared --no-autoupdate --config /etc/cloudflared-ctb/config.yml tunnel run
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=96M
MemoryMax=160M
TasksMax=64

[Install]
WantedBy=multi-user.target
