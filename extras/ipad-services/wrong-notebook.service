[Unit]
Description=Smart Wrong Notebook
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=wrong-notebook
Group=wrong-notebook
WorkingDirectory=/opt/wrong-notebook/current/node_modules/wrong-notebook
Environment=PATH=/opt/wrong-notebook/runtime/current/bin:/usr/bin:/bin
Environment=HOME=/var/lib/wrong-notebook
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=WRONG_NOTEBOOK_HOME=/var/lib/wrong-notebook
Environment=npm_config_cache=/var/cache/wrong-notebook
ExecStart=/opt/wrong-notebook/runtime/current/bin/node /opt/wrong-notebook/current/node_modules/wrong-notebook/bin/wrong-notebook.js --port 3000 --host 0.0.0.0 --data-dir /var/lib/wrong-notebook
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StateDirectory=wrong-notebook
StateDirectoryMode=0700
CacheDirectory=wrong-notebook
CacheDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=640M
MemoryMax=800M
TasksMax=96
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
