[Unit]
Description=Curriculum Knowledge Graph and Adaptive Diagnosis
After=network.target

[Service]
Type=simple
User=cn-math-taxonomy
Group=cn-math-taxonomy
ExecStart=/usr/bin/python3 /opt/cn-math-taxonomy/taxonomy-server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=cn-math-taxonomy
StateDirectoryMode=0700
MemoryHigh=96M
MemoryMax=160M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
