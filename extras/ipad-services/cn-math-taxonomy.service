[Unit]
Description=Curriculum Knowledge Graph and Adaptive Diagnosis
After=network.target

[Service]
Type=simple
User=cn-math-taxonomy
Group=cn-math-taxonomy
ExecStart=/usr/bin/python3 -m http.server 3002 --bind 127.0.0.1 --directory /opt/cn-math-taxonomy/current
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
